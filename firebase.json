{
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "Syntropy OS",
        "supportEmail": "nathan.debeaupuis@etu.estia.fr"
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "site": "evris-syntropy-os",
      "public": "out",
      "cleanUrls": true,
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/_next/static/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/Syntropy-OS-Setup-2.5.0.bin",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/vnd.microsoft.portable-executable"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"Syntropy-OS-Setup-2.5.0.exe\""
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        },
        {
          "source": "/*.exe",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/octet-stream"
            },
            {
              "key": "Content-Disposition",
              "value": "attachment; filename=\"Syntropy-OS-Setup-2.5.0.exe\""
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.exe"
      ]
    },
    {
      "site": "second-brain-os-e6a83",
      "public": "out",
      "cleanUrls": true,
